{
  "name": "neurogarden-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NeuroGarden browser client: watch the garden, play a fly.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run build && git diff --exit-code -- ../src/neurogarden/server/static",
    "test": "vitest run",
    "types": "node scripts/gen-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
